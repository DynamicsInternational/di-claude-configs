{
  "description": "AL development hooks — inject lead instructions and AL rules, compile on turn end",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/al-hook-context.js\" SessionStart instructions/lead.md",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/al-hook-context.js\" SubagentStart rules/al-engineering.md rules/al-naming.md",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/al-hook-context.js\" SubagentStart rules/al-architecture.md rules/al-conventions.md",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/al-hook-record.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/al-hook-compile.js\"",
            "timeout": 120,
            "statusMessage": "Compiling AL..."
          }
        ]
      }
    ]
  }
}
